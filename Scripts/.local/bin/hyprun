#!/bin/sh
. utils.sh

check_dep "jq"
check_dep "hyprctl"

appid="$1"
if [ "$2" = "--" ]; then
	shift 2
	appcmd="$*"
elif [ -n "$2" ]; then
	appcmd="$2"
else
	appcmd="$appid"
fi

if hyprctl activewindow -j | jq -r '.class' | grep -q "^$appid$"; then
	hyprctl dispatch "hl.dsp.window.move({ workspace = 'special:$appid', window = 'class:^$appid$', follow = false })"
	exit 0
else
	if hyprctl clients -j | jq -r '.[].class' | grep -q "^$appid$"; then
		hyprctl dispatch "hl.dsp.window.move({ workspace = 'm+0', window = 'class:^$appid$' })"
		hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = 'top', window = 'class:^$appid$' })"
		hyprctl dispatch "hl.dsp.focus({ window = 'class:^$appid$' })"
	else
		sh -c "$appcmd" &
	fi
	exit 0
fi
