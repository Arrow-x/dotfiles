#!/bin/sh
appid="g_nvim"
appargs="$*"
workspace=5
if [ "$XDG_CURRENT_DESKTOP" = "Hyprland" ]; then
	if ! hyprctl activewindow -j | jq -r '.class // empty' | grep -q "$appid"; then
		hyprctl dispatch "hl.dsp.window.move({ workspace = \"$workspace\", window = \"class:$appid\" })"
		hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"class:$appid\" })"
		hyprctl dispatch "hl.dsp.focus({ window = \"class:$appid\" })"
		if ! hyprctl activewindow -j | jq -r '.class // empty' | grep -q "$appid"; then
			hyprctl dispatch "hl.dsp.workspace({ id = $workspace })"
			sh -c "kitty --single-instance --app-id g_nvim nvim --listen /tmp/godothost.pipe" &
			# neovide --wayland_app_id "$appid"  -- --listen /tmp/godothost.pipe &
			sleep 0.5
		fi
	fi
else
	is_focused="$(swaymsg -t get_tree | jq -r '..|try select(.focused == true)' | grep "$appid")"
	if [ -z "$is_focused" ]; then
		focus="$(swaymsg "[app_id=$appid] focus" | grep success)"
		if echo "$focus" | grep -q false; then
			sh -c "kitty --single-instance g_nvim nvim --listen /tmp/godothost.pipe" &
			sleep 0.5
		fi
	fi
fi
nvim --server /tmp/godothost.pipe --remote-send "$appargs" &
