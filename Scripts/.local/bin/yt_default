#!/bin/sh

link="$(printf "%s" "$1" | cut --delimiter="&" -f1)"
video_title="$(grep "$link" "$HOME"/.cache/yttitle | cut -d "|" -f2 | head -n 1)"

if printf "%s" "$1" | grep "shorts"; then
	video_id="$(printf "%s" "$link" | cut -d "/" -f5 | cut --delimiter="&" -f1)"
else
	video_id="$(printf "%s" "$link" | cut -d "/" -f4 | sed 's/watch?v=//' | cut --delimiter="&" -f1)"
fi

json_id="$(printf "$HOME/.cache/yt/%s.json" "$(printf "%s" "$video_id" | sed 's/watch?v=//' | cut --delimiter="&" -f1)")"

threads=11

ERROR_AUDIO=/tmp/cantgetaudio
ERROR_VID=/tmp/cantgetvideo

menu() {
	# cat | bemenu -l 3 --prompt "$video_title"
	fuzzel --dmenu --placeholder="$video_title"
	# fzfmenu.sh
}

choice="$(printf "1080p\n1080p60\nAudio\nAuto\n" | menu)"

[ -z "$choice" ] && exit 1

clean_exit() {
	rm -rf /tmp/yt*
	rm -rf /tmp/cantget*
	rm -rf /tmp/watch*
	rm -rf /tmp/shorts
	rm -rf /tmp/"$video_id"*
	exit "$1"
}

try_getting() {
	rm -rf "$3"
	if ! yt-dlp -N $threads --no-part -f "$1" --load-info-json "$json_id" -o "$2" "$link"; then
		notify-send -u low -i /usr/share/icons/Qogir/32/status/dialog-error.svg "$4"
		touch "$3"
		notify-send "$video_id"
		# rm -rf "$json_id"
	fi
}

check_file() {
	file_path="$1"
	error_file="$2"
	timeout_seconds=30
	check_interval=1
	start_time=$(date +%s)
	elapsed=0

	while [ ! -f "$file_path" ]; do
		if [ -f "$error_file" ]; then
			rm -rf "$error_file"
			return 1
		fi

		if [ "$timeout_seconds" -gt 0 ] && [ "$elapsed" -ge "$timeout_seconds" ]; then
			notify-send -u low -i /usr/share/icons/Qogir/32/status/dialog-error.svg "Timout reached while waiting "
			return 1
		fi
		sleep $check_interval
		elapsed=$(($(date +%s) - start_time))
	done
	return 0
}

get_video() {
	try_getting "ba" /tmp/ytaudio "$ERROR_AUDIO" "No Audio" &
	try_getting "bv*[height<=1080][fps<=$1][vcodec=vp9] " /tmp/"$video_id" "$ERROR_VID" "No Video" &

	if ! check_file "/tmp/ytaudio" "$ERROR_AUDIO"; then
		clean_exit 1
	fi
	if ! check_file "/tmp/$video_id" "$ERROR_VID"; then
		clean_exit 1
	fi
	mpv --audio-file="/tmp/ytaudio" --really-quiet --no-terminal --force-window /tmp/"$video_id"
	clean_exit 0
}

case "$choice" in
"Audio")
	try_getting "ba" /tmp/"$video_id" "$ERROR_AUDIO" "No Audio" &
	if ! check_file /tmp/"$video_id" "$ERROR_AUDIO"; then
		clean_exit 1
	fi
	mpv --really-quiet --no-terminal --force-window /tmp/"$video_id"
	clean_exit 0
	;;
"1080p")
	get_video 30
	;;
"1080p60")
	get_video 60
	;;
"Auto")
	get_video "bv"
	;;
esac
