#!/bin/sh
. utils.sh

usage() { #help message
	logsout "This program converts a Windows version of an NW.js program into its Linux counterpart."
	logsout "The Linux version is not guaranteed to work and a backup of the Windows version is always advised."
	logsout "The installation process takes a while. Don't worry if almost everything disappears from the directory and then nothing seems to happen. It's normal."
	logsout ""
	logsout "Parameters:"
	logsout "  -h, --help                  Shows this message and exits"
	logsout "  -ns, --no-start             Doesn't start the game after the installation"
	logsout "  -cs, --case-sensitive       Skip the setting up of case_insestive script and setup, on by defult"
	logsout "  -p, --defult-package-json   create a default package.json"
}

start_game=1
ci=1
p=0

while [ "$1" != "" ]; do #positional parameters
	case $1 in
	-h | --help)
		usage
		exit 0
		;;
	-ns | --no-start) #doesn't start the game after the installation
		start_game=0
		;;
	-cs | --case-sensitive)
		ci=0
		;;
	-p | --defult-package-json)
		p=1
		;;
	*)
		usage
		exit 0
		;;
	esac
	shift
done

check_dep "cicpoffs"
check_dep "wget"

IS_RPGMV=false
IS_RPGMZ=false

#test to avoid accidental and irreversible deletion of files and directories
if [ -d "www" ] && [ -f "package.json" ]; then
	logsout "This looks like an RPGMV Game."
	IS_RPGMV=true
elif
	[ -d "audio" ] &&
		[ -d "css" ] &&
		[ -d "data" ] &&
		[ -d "effects" ] &&
		[ -f "package.json" ] &&
		[ -d "fonts" ] &&
		[ -d "img" ] &&
		[ -d "icon" ] &&
		[ -d "js" ] &&
		[ -d "locales" ]
then
	logsout "This looks like an RPGMZ Game."
	IS_RPGMZ=true
fi

if [ $IS_RPGMV = false ] && [ $IS_RPGMZ = false ]; then
	logerr "This doesn't look like nwjs program"
	exit 1
fi

version="$(wget https://dl.nwjs.io/ -q -O - | tail -n -5 | head -n 1 | sed -E 's#.*href="(.*)\/".*#\1#')"

parent_dir_name="$HOME/Games/VN/tools/"
mkdir --parents "$parent_dir_name"

if [ -z "$version" ]; then
	logerr "couldn't quary the latest nwjs version, check your internet connection ..."
	logerr "checking local nwjs version ..."
	file_name=$(find "$parent_dir_name" -name "nwjs-v*" | sort | tail -n 1 | xargs basename)
	if [ -z "$file_name" ]; then
		logerr "there is no local nwjs version, aborting"
		exit 4
	fi
	dir_name=$(echo "$file_name" | sed 's/.tar.gz//')
else
	dir_name="nwjs-""$version""-linux-x64"
	file_name="$dir_name"".tar.gz"
fi

destination="$parent_dir_name""$file_name"

if [ ! -f "$destination" ]; then
	logsout "downloading the lates nwjs for your computer ..."
	link="https://dl.nwjs.io/""$version""/""$file_name"
	if ! wget "$link" --continue --output-document "$destination"; then
		logerr "couldn't get the latest nwjs, please check your internet connection"
		exit 4
	fi
else
	logsout "the latest nwjs is already downloaded ..."
fi

chmod +w .
logsout "removes unneeded files ..."
if $IS_RPGMV; then
	find . -maxdepth 1 -not -name "." -not -name "nw.pak" -not -name "*.json" -not -name "www" -not -name "css" -not -name "data" -not -name "csv" -not -name "*.xlsx" -print0 | xargs -0 -r rm -r --
elif $IS_RPGMZ; then
	rm -r locales swiftshader ./*.exe ./*.dat ./*.dll ./*.pak ./*.bin credits.html
fi

logsout "copying NWjs ..."
cp "$destination" .

logsout "extracting ..."
tar -xzf "$file_name"

logsout "files are in a directory, moving them in the right place ..."
mv "$dir_name"/* .

logsout "cleaning useless file and directory ..."
rm -r "$dir_name"
rm "$file_name"

if [ ! -x "nw" ]; then
	logsout "making the launching bin excutable ..."
	chmod +x nw
fi

if [ "$ci" -eq 1 ]; then
	logsout "setting up data to be case insensitive ..."
	if $IS_RPGMV; then
		mv www/ www_cs/
		mkdir www
		logsout "creating launcher script ..."
		touch playme.sh
		{
			logsout "#!/bin/sh"
			logsout "cicpoffs www_cs www"
			logsout "./nw"
			logsout "umount -l www"
		} >playme.sh

	elif $IS_RPGMZ; then
		mv img/ img_cs/
		mkdir img
		mv audio/ audio_cs/
		mkdir audio
		logsout "creating launcher script ..."
		touch playme.sh
		{
			logsout "#!/bin/sh"
			logsout "cicpoffs img_cs img"
			logsout "cicpoffs audio_cs audio"
			logsout "./nw"
			logsout "umount -l img"
			logsout "umount -l audio"
		} >playme.sh
	fi
	chmod +x playme.sh

	if [ $p = 1 ]; then
		rm package.json
		{
			logsout '{'
			logsout '	"name": "s",'
			logsout '	"main": "www/index.html",'
			logsout '	"js-flags": "--expose-gc",'
			logsout '	"window": {'
			logsout '	    "title": "",'
			logsout '	    "toolbar": false,'
			logsout '	    "width": 816,'
			logsout '	    "height": 624,'
			logsout '	    "icon": "www/icon/icon.png"'
			logsout '	}'
			logsout '}'
		} >package.json
	fi

	if [ $start_game -eq 1 ]; then
		logsout "Running the game ..."
		./playme.sh
	fi
	exit 0
fi

if [ $start_game -eq 1 ]; then
	logsout "Running the game ..."
	./nw
fi
