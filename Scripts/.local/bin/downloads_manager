#!/bin/sh
. utils.sh

help="this is the help text"
case "$1" in
-h | --help | '')
	printf "%s\n" "$help"
	exit 0
	;;
*)
	url="$1"
	;;
esac

check_dep yt-dlp
check_dep gallery-dl
check_dep aria2c

y_tube() {
	menu() {
		cat | bemenu -l 3
		# fzfmenu.sh
	}

	choice="$(printf "720p\n720p60\nAudio\n" | menu)"

	[ -z "$choice" ] && exit 1
	case $choice in
	"720p")
		yt-dlp --embed-subs --embed-metadata --embed-thumbnail --embed-chapters -P home:"$HOME"/Videos -f "bv[height<=720] [fps<=30]+ba" "$1"
		;;
	"720p60")
		yt-dlp --embed-subs --embed-metadata --embed-thumbnail --embed-chapters -P home:"$HOME"/Videos -f "bv[height<=720] [fps<=60]+ba" "$1"
		;;
	"Audio")
		yt-dlp --embed-subs --embed-metadata --embed-thumbnail --embed-chapters -P home:"$HOME"/Videos -f "ba" "$1"
		;;
	esac

}

d_failed() {
	notify-send -u low -i /usr/share/icons/Qogir/32/status/dialog-error.svg \
		"Failed to download"
	exit 1
}

retry() {
	notify-send -u low -i /usr/share/icons/Qogir/32/status/system-reboot.svg \
		"$(printf "Couldn't get %s, attempting %s" "$1" "$2")"
}

download_url() {
	notify-send -u low -i /usr/share/icons/Qogir/32/status/system-save-session.svg \
		"downloading the $1 at $2"

	case "$1" in
	"Youtube")
		if ! y_tube "$2"; then
			d_failed
		fi
		;;
	"Picture")
		if ! gallery-dl "$2"; then
			d_failed
		fi
		;;
	"Hentai")
		if ! gallery-dl --exec-after "setsid -f $IMAGE {_directory}" "$2"; then
			d_failed
		fi
		;;
	"Pixeldrain")
		link="$(printf "%s" "$2" | sed 's#.*/u/##')"
		mkdir -p "$HOME"/Downloads/Homework/H-Games
		if ! "$TERMINAL" curl -L -OJ --output-dir "$HOME"/Downloads/Homework/H-Games/ "$(printf "https://pixeldrain.com/api/file/%s?download" "$link")"; then
			d_failed
		fi
		;;
	"Fic")
		if ! "$TERMINAL" sh -c "fichub_cli -o $HOME/Documents/Books/Fanfiction/ --force -u \"$2\""; then
			d_failed
		fi
		;;
	"Emulation")
		! "$TERMINAL" aria2c --check-integrity=true -d "$HOME"/File/Games/Emulators/ "$2" && d_failed
		;;
	"General")
		if ! "$TERMINAL" aria2c --check-integrity=true -d "$HOME"/Downloads "$2"; then
			d_failed
		fi
		;;
	esac

	notify-send -u low -i /usr/share/icons/Qogir/32/status/security-high.svg \
		"Done Downloading the $1 at $2"
}

parse_url() {
	case "$1" in
	*'youtube.com/watch'* | *'youtube.com/playlist'* | *'youtube.com/shorts'* | *'youtu.be'*)
		printf "Youtube"
		;;

	*'twitter.com'* | *'mangasee'* | *'tumblr'* | *'x.com'* | *'bsky.app'* | *'artstation'*)
		printf "Picture"
		;;

	*'nhentai.net'* | *'e-hentai.org'*)
		printf "Hentai"
		;;

	*'pixeldrain'*)
		printf "Pixeldrain"
		;;

	*'spacebattles'* | *'alternatehistory'*)
		check_dep fichub_cli
		printf "Fic"
		;;

	*'cdromance'*)
		printf "Emulation"
		;;

	*)
		printf "General"
		;;
	esac
}

download_url "$(parse_url "$url")" "$url"
